# API
AGENTFORGE_ENV=development
AGENTFORGE_DATABASE_URL=
AGENTFORGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AGENTFORGE_DEMO_MODE=true

# Optional OpenAI-compatible model provider.
# Leave these empty to use the deterministic demo model.
AGENTFORGE_LLM_BASE_URL=
AGENTFORGE_LLM_API_KEY=
AGENTFORGE_LLM_MODEL=
AGENTFORGE_LLM_EMBEDDING_MODEL=
AGENTFORGE_LLM_TRUST_ENV=false

# Local MCP Bridge. `npm run dev` injects a temporary shared token.
AGENTFORGE_MCP_BRIDGE_URL=http://127.0.0.1:8765
AGENTFORGE_MCP_BRIDGE_TOKEN=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000

