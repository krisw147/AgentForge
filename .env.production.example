# Public endpoint
PUBLIC_HOST=agentforge.example.com
PUBLIC_ORIGIN=https://agentforge.example.com

# PostgreSQL
POSTGRES_DB=agentforge
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Internal MCP bridge
MCP_BRIDGE_TOKEN=replace-with-a-long-random-token

# Model provider
AGENTFORGE_LLM_BASE_URL=https://api.deepseek.com/v1
AGENTFORGE_LLM_API_KEY=
AGENTFORGE_LLM_MODEL=deepseek-chat
AGENTFORGE_LLM_EMBEDDING_MODEL=
AGENTFORGE_LLM_TRUST_ENV=false
